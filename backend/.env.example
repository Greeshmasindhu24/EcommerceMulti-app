# Neon PostgreSQL (recommended)
DATABASE_URL=postgresql://[USER]:[PASSWORD]@[HOST]-pooler.[REGION].aws.neon.tech/neondb?sslmode=require
POSTGRES_URL=postgresql://[USER]:[PASSWORD]@[HOST]-pooler.[REGION].aws.neon.tech/neondb?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://[USER]:[PASSWORD]@[HOST].[REGION].aws.neon.tech/neondb?sslmode=require

POSTGRES_HOST=[HOST]-pooler.[REGION].aws.neon.tech
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=your-password
POSTGRES_DATABASE=neondb

GEMINI_API_KEY=your-gemini-api-key
JWT_SECRET_KEY=your-jwt-secret
SECRET_KEY=your-secret-key
